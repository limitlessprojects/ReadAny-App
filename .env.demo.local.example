# Copy to .env.demo.local (gitignored) and fill in.
# Keys are injected server-side by the vite proxies — never shipped to the client.

# Google Gemini free tier (https://aistudio.google.com/apikey)
# Works from supported regions (Kenya is listed; HK/SG datacenter IPs are not).
GEMINI_API_KEY=

# Optional — defaults to the local mock (scripts/mock-llm-server.mjs :8787).
# Point at the real endpoint when you have connectivity from a supported region:
# GEMINI_API_TARGET=https://generativelanguage.googleapis.com

# Cerebras (competition variant — needs a funded key)
# CEREBRAS_API_TARGET=https://api.cerebras.ai
# CEREBRAS_API_KEY=

# BYOK providers — the server proxy passes the user's own key through.
# No server-side key needed for these (targets overridable for tests/mirrors):
# ANTHROPIC_API_TARGET=https://api.anthropic.com
# OPENAI_API_TARGET=https://api.openai.com
